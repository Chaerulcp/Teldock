{
  "name": "teldock-backend",
  "version": "1.0.0",
  "description": "Teldock — Backend API for a Telegram-backed cloud storage app",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node scripts/migrate.js",
    "migrate:chunked": "node scripts/migrate-chunked-storage.js",
    "migrate:drop-quota": "node scripts/migrate-drop-quota.js",
    "migrate:widen-share-token": "node scripts/migrate-widen-share-token.js",
    "migrate:version-snapshots": "node scripts/migrate-version-snapshots.js",
    "migrate:tags-favorites": "node scripts/migrate-tags-favorites.js",
    "test-auth": "node tests/test-auth.js",
    "test-db": "node scripts/test-database.js",
    "test": "node --test tests/*.test.js",
    "lint": "eslint \"src/**/*.js\" \"tests/**/*.js\" \"scripts/**/*.js\" \"*.js\"",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\" \"scripts/**/*.js\" \"*.js\" \"*.json\""
  },
  "keywords": [
    "telegram",
    "cloud-storage",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "busboy": "^1.6.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "^4.0.6",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "mysql2": "^3.24.2",
    "sequelize": "^6.37.8",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.3.0",
    "eslint": "^10.10.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  }
}
